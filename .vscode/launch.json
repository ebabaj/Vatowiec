{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Server/Api/bin/Debug/net10.0/Vatowiec.Api.dll",
      "cwd": "${workspaceFolder}/src/Server/Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7243;http://localhost:5243"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Desktop",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Desktop/bin/Debug/net10.0/Vatowiec.Desktop.dll",
      "cwd": "${workspaceFolder}/src/Desktop",
      "console": "integratedTerminal"
    }
  ]
}
