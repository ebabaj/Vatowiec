<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vatowiec.Desktop.MainWindow"
        xmlns:vm="using:Vatowiec.Desktop.ViewModels"
        xmlns:contracts="using:Vatowiec.SharedContracts"
        xmlns:converters="using:Vatowiec.Desktop.Converters"
        xmlns:desktop="using:Vatowiec.Desktop"
        x:DataType="vm:MainViewModel"
        Title="VATowiec — firmy i kontrahenci"
        Width="1180" Height="860"
        MinWidth="900" MinHeight="500"
        KeyDown="WindowKeyDown"
        WindowStartupLocation="CenterScreen">
  <Window.Resources><converters:FinanceCurrencyLabelConverter x:Key="FinanceCurrencyLabel"/></Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="32" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="VATowiec" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Firmy i kontrahenci · M0" Opacity="0.7" />
      </StackPanel>
      <StackPanel Grid.Column="1" IsVisible="{Binding !IsLogin}" HorizontalAlignment="Right">
        <TextBlock Text="{Binding CurrentUser}" FontWeight="SemiBold" AutomationProperties.AutomationId="CurrentUser" />
        <TextBlock Text="{Binding SessionExpiry}" Opacity="0.7" />
        <Button Content="Zmień własne hasło" Click="OwnPasswordClick" IsVisible="{Binding CanOpenOwnPasswordChange}" AutomationProperties.AutomationId="OwnPassword"/>
        <Button Content="Zapomnij dane logowania" Click="ForgetLoginClick" AutomationProperties.AutomationId="ForgetLoginSignedIn"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" IsEnabled="{Binding CanUseForm}">
      <ScrollViewer IsVisible="{Binding IsLogin}">
        <StackPanel MaxWidth="460" HorizontalAlignment="Stretch" Spacing="10" Margin="0,24">
          <TextBlock Text="Zaloguj się" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Text="Adres serwera API (HTTPS)" IsVisible="{Binding !IsPersonal}" />
          <TextBox Text="{Binding ApiAddress, Mode=TwoWay}" IsVisible="{Binding !IsPersonal}" AutomationProperties.AutomationId="ApiAddress" />
          <TextBlock Text="Połączenie lokalne — zabezpieczony kanał Windows" IsVisible="{Binding IsPersonal}" TextWrapping="Wrap" />
          <TextBlock Text="Na innym komputerze podaj adres HTTPS serwera otrzymany od administratora. localhost oznacza ten komputer."
                     TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding !IsPersonal}" />
          <TextBlock Text="Login" />
          <TextBox x:Name="LoginInput" Text="{Binding UserName, Mode=TwoWay}" MaxLength="256"
                   AutomationProperties.AutomationId="Login" />
          <TextBlock Text="Hasło" />
          <TextBox x:Name="PasswordInput" PasswordChar="●" MaxLength="1024" KeyDown="PasswordKeyDown" PlaceholderText="{Binding SavedPasswordMask}"
                   AutomationProperties.AutomationId="Password" />
          <TextBlock Text="{Binding SavedPasswordStatus}" IsVisible="{Binding HasSavedPassword}" AutomationProperties.AutomationId="SavedPasswordStatus"/>
          <CheckBox Content="Zapamiętaj dane logowania na tym komputerze" IsChecked="{Binding RememberCredentials, Mode=TwoWay}" AutomationProperties.AutomationId="RememberCredentials"/>
          <CheckBox Content="Loguj automatycznie przy uruchomieniu" IsChecked="{Binding AutomaticLogin, Mode=TwoWay}" IsEnabled="{Binding RememberCredentials}" AutomationProperties.AutomationId="AutomaticLogin"/>
          <Button Content="Zaloguj się" Click="LoginClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="0,12,0,0" AutomationProperties.AutomationId="LoginButton" />
          <Button Content="Zapomnij dane logowania" Click="ForgetLoginClick" AutomationProperties.AutomationId="ForgetLogin"/>
          <TextBlock Text="Zapamiętywanie hasła i autologowanie są przeznaczone wyłącznie dla zaufanego konta Windows. Hasło trafia tylko do Windows Credential Manager, sesja pozostaje w pamięci. Puste pole hasła pozwala użyć zapamiętanego poświadczenia dla tego adresu API i loginu. Wymagany jest zaufany certyfikat HTTPS serwera."
                     TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0" IsVisible="{Binding !IsPersonal}" />
          <TextBlock Text="Hasło można zapamiętać wyłącznie w Windows Credential Manager tego konta Windows. Sesja pozostaje w pamięci i dotyczy tej instalacji Personal." TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding IsPersonal}" />
        </StackPanel>
      </ScrollViewer>

      <Grid IsVisible="{Binding IsCompanySelection}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
        <TextBlock Text="Wybierz firmę" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Lista zawiera wyłącznie firmy udostępnione Twojemu kontu. Jeśli jest pusta, odśwież ją lub skontaktuj się z administratorem."
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="{Binding DefaultCompanyLabel}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="DefaultCompanyLabel"/>
        <ListBox Grid.Row="3" ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}" DoubleTapped="CompaniesDoubleTapped"
                 AutomationProperties.AutomationId="Companies" MinHeight="120" />
        <WrapPanel Grid.Row="4">
          <Button Content="Ustawienia instalacji" Click="GusSettingsClick" IsVisible="{Binding IsInstallationAdministrator}" IsEnabled="{Binding CanOpenGusSettings}" AutomationProperties.AutomationId="InstallationSettingsSelection"/>
          <Button Content="Otwórz firmę" Click="OpenCompanyClick" AutomationProperties.AutomationId="OpenCompany" />
          <Button Content="Ustaw jako domyślną" Click="SetDefaultCompanyClick" IsEnabled="{Binding CanSetDefaultCompany}" AutomationProperties.AutomationId="SetDefaultCompany"/>
          <Button Content="Usuń firmę domyślną" Click="ClearDefaultCompanyClick" AutomationProperties.AutomationId="ClearDefaultCompany"/>
          <Button Content="Odśwież listę" Click="RefreshCompaniesClick" />
          <Button Content="Wyloguj" Click="LogoutClick" AutomationProperties.AutomationId="LogoutSelection" />
        </WrapPanel>
      </Grid>

      <Grid IsVisible="{Binding IsBrowsingWorkspace}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="14">
        <TextBlock Text="{Binding CurrentCompany}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="CurrentCompany" />
        <WrapPanel Grid.Row="1">
          <Button Content="Słowniki → Waluty i kursy NBP" Click="CurrenciesClick" IsVisible="{Binding CanViewRates}" AutomationProperties.AutomationId="OpenCurrencies"/><Button Content="Ustawienia firmy" Click="DataPortSettingsClick" AutomationProperties.AutomationId="CompanySettings"/><Button Content="Zmień firmę" Click="ChangeCompanyClick" AutomationProperties.AutomationId="ChangeCompany" />
          <Button Content="Ustawienia instalacji" Click="GusSettingsClick" IsVisible="{Binding IsInstallationAdministrator}" IsEnabled="{Binding CanOpenGusSettings}" AutomationProperties.AutomationId="InstallationSettings"/>
          <Button Content="Wyloguj" Click="LogoutClick" AutomationProperties.AutomationId="LogoutWorkspace" />
          <Button Content="Nowy (Ctrl+N)" Click="NewContractorClick" IsVisible="{Binding CanEditContractors}" AutomationProperties.AutomationId="NewContractor" />
          <Button Content="Otwórz (F2)" Click="EditContractorClick" IsVisible="{Binding CanViewContractors}" AutomationProperties.AutomationId="EditContractor" />
        </WrapPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <TextBlock Text="Kontrahenci" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Pokaż kontrahentów / odśwież" Click="ContractorsClick"
                  IsVisible="{Binding CanViewContractors}" AutomationProperties.AutomationId="ShowContractors" />
        </Grid>
        <Grid Grid.Row="3" IsVisible="{Binding CanBrowse}" ColumnDefinitions="*,100,150,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Szukaj: kod, nazwa lub identyfikator (Ctrl+F)" />
            <TextBox x:Name="SearchInput" Text="{Binding SearchText, Mode=TwoWay}" MaxLength="128" KeyDown="SearchKeyDown" AutomationProperties.AutomationId="ContractorSearch" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Kraj (opcjonalnie)" />
            <TextBox Text="{Binding FilterCountry, Mode=TwoWay}" MaxLength="2" KeyDown="SearchKeyDown" AutomationProperties.AutomationId="FilterCountry" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="Status" />
            <ComboBox SelectedIndex="{Binding FilterActivity, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FilterActivity">
              <ComboBoxItem Content="Wszyscy" /><ComboBoxItem Content="Aktywni" /><ComboBoxItem Content="Nieaktywni" />
            </ComboBox>
          </StackPanel>
          <Button Grid.Column="3" Content="Szukaj" Click="ContractorsClick" VerticalAlignment="Bottom" AutomationProperties.AutomationId="SearchContractors" />
        </Grid>
        <TextBlock Grid.Row="4" Text="Brak uprawnień do kartoteki kontrahentów."
                   IsVisible="{Binding CannotViewContractors}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" Text="{Binding ContractorStatus}" IsVisible="{Binding CanViewContractors}" />
        <Grid Grid.Row="5" IsVisible="{Binding CanViewContractors}" RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <Border Background="#182A7DB1" Padding="12,8">
            <Grid ColumnDefinitions="110,*,160,60,100">
              <TextBlock Text="Kod" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Nazwa kontrahenta" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Identyfikator podatkowy" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="Kraj" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Contractors}" SelectedItem="{Binding SelectedContractor, Mode=TwoWay}" DoubleTapped="ContractorDoubleTapped" AutomationProperties.AutomationId="Contractors">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="contracts:ContractorResponse">
                <Grid ColumnDefinitions="110,*,160,60,100" Margin="8" HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding Code}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="2" Text="{Binding TaxId}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="3" Text="{Binding CountryCode}" />
                  <TextBlock Grid.Column="4" Text="{Binding ActivityLabel}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
            </ListBox.Styles>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button Content="Poprzednia" Click="PreviousPageClick" IsEnabled="{Binding HasPreviousPage}" />
            <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" />
            <Button Content="Następna" Click="NextPageClick" IsEnabled="{Binding HasNextPage}" />
          </StackPanel>
        </Grid>
      </Grid>

      <Grid IsVisible="{Binding IsCurrencyScreen}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding CurrencyScreenTitle}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CurrentCompany}" TextWrapping="Wrap"/>
          <WrapPanel><Button Content="Kursy zapisane" Click="CurrencyRatesTabClick" AutomationProperties.AutomationId="RatesTab"/><Button Content="Odśwież słownik" Click="RefreshCurrenciesClick" AutomationProperties.AutomationId="RefreshCurrencies"/><Button Content="Ustawienia pobierania" Click="CurrencySettingsTabClick" AutomationProperties.AutomationId="CurrencySettingsTab"/><Button Content="Wróć do kontrahentów" Click="CloseCurrenciesClick" AutomationProperties.AutomationId="CloseCurrencies"/></WrapPanel>
        </StackPanel>
        <WrapPanel Grid.Row="1" IsEnabled="{Binding CanImportRates}">
          <ComboBox SelectedIndex="{Binding ImportMode, Mode=TwoWay}" AutomationProperties.AutomationId="NbpImportMode"><ComboBoxItem Content="Najnowsze kursy"/><ComboBoxItem Content="Za okres publikacji"/></ComboBox>
          <DatePicker SelectedDate="{Binding ImportFrom, Mode=TwoWay}" AutomationProperties.AutomationId="NbpFrom"/>
          <TextBlock Text="do" VerticalAlignment="Center" Margin="8"/>
          <DatePicker SelectedDate="{Binding ImportTo, Mode=TwoWay}" AutomationProperties.AutomationId="NbpTo"/>
          <Button Content="Pobierz kursy z NBP" Click="ImportNbpClick" AutomationProperties.AutomationId="ImportNbp"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="2" MaxHeight="125"><StackPanel><TextBlock Text="Daty od/do są używane tylko w trybie „Za okres”; to daty publikacji, nie dokumentów. A/B: średni. C: kupna i sprzedaży. NBP nie wymaga klucza. PLN nie jest pobierany." TextWrapping="Wrap" Opacity="0.75"/><TextBlock Text="{Binding RateImportSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="NbpSummary"/></StackPanel></ScrollViewer>
        <Grid Grid.Row="3" IsVisible="{Binding IsCurrencySettings}" ColumnDefinitions="*,*" ColumnSpacing="18">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
            <TextBox Text="{Binding CurrencySearch, Mode=TwoWay}" PlaceholderText="Szukaj kodu lub nazwy waluty" AutomationProperties.AutomationId="CurrencySearch"/>
            <StackPanel Grid.Row="1" Spacing="5">
              <WrapPanel IsEnabled="{Binding CanStartCurrencyActivity}">
                <Button Content="Zaznacz widoczne" Click="SelectVisibleCurrenciesClick" AutomationProperties.AutomationId="SelectVisibleCurrencies"/>
                <Button Content="Zaznacz wszystkie" Click="SelectAllCurrenciesClick" AutomationProperties.AutomationId="SelectAllCurrencies"/>
                <Button Content="Wyczyść zaznaczenie" Click="ClearCurrencySelectionClick" AutomationProperties.AutomationId="ClearCurrencySelection"/>
              </WrapPanel>
              <TextBlock Text="{Binding CurrencySelectionCount}" AutomationProperties.AutomationId="CurrencySelectionCount"/>
            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding VisibleCurrencySelections}" SelectedItem="{Binding SelectedCurrencySelection, Mode=TwoWay}" AutomationProperties.AutomationId="CurrencyList">
              <ListBox.ItemTemplate><DataTemplate x:DataType="vm:CurrencySelection">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanStartCurrencyActivity}" AutomationProperties.AutomationId="CurrencyBulkCheck" AutomationProperties.Name="{Binding Code}"/>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <ScrollViewer Grid.Column="1"><StackPanel Spacing="10">
            <StackPanel Spacing="6" IsEnabled="{Binding CanStartCurrencyActivity}">
              <TextBlock Text="Zbiorowa zmiana aktywności" FontWeight="SemiBold"/>
              <WrapPanel>
                <Button Content="Aktywuj zaznaczone" Click="ActivateCurrenciesClick" AutomationProperties.AutomationId="ActivateCurrencies"/>
                <Button Content="Dezaktywuj zaznaczone" Click="DeactivateCurrenciesClick" AutomationProperties.AutomationId="DeactivateCurrencies"/>
                <Button Content="Aktywuj wszystkie" Click="ActivateAllCurrenciesClick" AutomationProperties.AutomationId="ActivateAllCurrencies"/>
                <Button Content="Dezaktywuj wszystkie" Click="DeactivateAllCurrenciesClick" AutomationProperties.AutomationId="DeactivateAllCurrencies"/>
              </WrapPanel>
            </StackPanel>
            <Border IsVisible="{Binding CurrencyActivityPrompt}" BorderBrush="Orange" BorderThickness="2" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding CurrencyActivityConfirmation}" TextWrapping="Wrap" AutomationProperties.AutomationId="CurrencyActivityConfirmation"/>
                <WrapPanel IsEnabled="{Binding CanInteract}">
                  <Button Content="Potwierdź zmianę zbiorczą" Click="ConfirmCurrencyActivityClick" AutomationProperties.AutomationId="ConfirmCurrencyActivity"/>
                  <Button Content="Anuluj" Click="CancelCurrencyActivityClick" AutomationProperties.AutomationId="CancelCurrencyActivity"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding CurrencyEditor.Label}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel IsEnabled="{Binding CanEditCurrencySettings}" Spacing="7">
              <CheckBox Content="Waluta aktywna" IsChecked="{Binding CurrencyEditor.IsActive, Mode=TwoWay}" IsEnabled="{Binding !CurrencyEditor.IsPln}" AutomationProperties.AutomationId="CurrencyActive"/>
              <StackPanel IsEnabled="{Binding CanChooseCurrencyTables}">
                <CheckBox Content="Tabela A — kurs średni" IsChecked="{Binding CurrencyEditor.DownloadA, Mode=TwoWay}" AutomationProperties.AutomationId="CurrencyA"/>
                <CheckBox Content="Tabela B — kurs średni (rzadsze publikacje)" IsChecked="{Binding CurrencyEditor.DownloadB, Mode=TwoWay}" AutomationProperties.AutomationId="CurrencyB"/>
                <CheckBox Content="Tabela C — kurs kupna i sprzedaży" IsChecked="{Binding CurrencyEditor.DownloadC, Mode=TwoWay}" AutomationProperties.AutomationId="CurrencyC"/>
              </StackPanel>
              <WrapPanel><Button Content="Zapisz ustawienia waluty" Click="SaveCurrencyClick" AutomationProperties.AutomationId="SaveCurrency"/><Button Content="Porzuć zmiany" Click="CancelCurrencyClick" AutomationProperties.AutomationId="CancelCurrency"/></WrapPanel>
            </StackPanel>
            <TextBlock Text="Zapis dotyczy wybranej waluty i nie pobiera kursów. Wyłączenie waluty zachowuje jej historię i usuwa wybór pobierania. PLN zawsze pozostaje aktywny, bez kursu NBP. Dostępność waluty zależy od tabeli; brak jest raportowany, bez fikcyjnego kursu." TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid Grid.Row="3" IsVisible="{Binding IsRateList}" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6">
          <WrapPanel>
            <ComboBox Width="300" ItemsSource="{Binding RateCurrencyChoices}" SelectedItem="{Binding SelectedRateCurrency, Mode=OneWay}" SelectionChanged="RateCurrencySelectionChanged" ToolTip.Tip="{Binding SelectedRateCurrency}" AutomationProperties.AutomationId="RateCurrencyFilter"/>
            <CheckBox Content="Pokaż nieaktywne (archiwum)" IsChecked="{Binding ShowInactiveRateCurrencies, Mode=OneWay}" Click="ShowInactiveRateCurrenciesClick" AutomationProperties.AutomationId="ShowInactiveRateCurrencies"/>
            <ComboBox SelectedIndex="{Binding RateTableFilter, Mode=TwoWay}" AutomationProperties.AutomationId="RateTableFilter"><ComboBoxItem Content="Wszystkie tabele"/><ComboBoxItem Content="A — średni"/><ComboBoxItem Content="B — średni"/><ComboBoxItem Content="C — kupna/sprzedaży"/></ComboBox>
            <DatePicker SelectedDate="{Binding RateFromFilter, Mode=TwoWay}" AutomationProperties.AutomationId="RateFilterFrom"/><DatePicker SelectedDate="{Binding RateToFilter, Mode=TwoWay}" AutomationProperties.AutomationId="RateFilterTo"/>
            <CheckBox Content="Najnowsze najpierw" IsChecked="{Binding RateDescending, Mode=TwoWay}"/>
            <Button Content="Filtruj" Click="FilterRatesClick" AutomationProperties.AutomationId="FilterRates"/><Button Content="Wyczyść filtry" Click="ClearRateFiltersClick"/>
          </WrapPanel>
          <Grid Grid.Row="1" ColumnDefinitions="100,65,50,170,115,*" Margin="6,0,16,0"><TextBlock Text="Publikacja"/><TextBlock Grid.Column="1" Text="Waluta"/><TextBlock Grid.Column="2" Text="Tabela"/><TextBlock Grid.Column="3" Text="Numer NBP"/><TextBlock Grid.Column="4" Text="Notowanie"/><TextBlock Grid.Column="5" Text="Kurs PLN za jednostkę waluty"/></Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding RateRows}" AutomationProperties.AutomationId="RateList"><ListBox.ItemTemplate><DataTemplate x:DataType="contracts:RateResponse"><Grid ColumnDefinitions="100,65,50,170,115,*"><TextBlock Text="{Binding DateLabel}"/><TextBlock Grid.Column="1" Text="{Binding CurrencyCode}"/><TextBlock Grid.Column="2" Text="{Binding TableType}"/><TextBlock Grid.Column="3" Text="{Binding TableNumber}"/><TextBlock Grid.Column="4" Text="{Binding TradingDateLabel}"/><TextBlock Grid.Column="5" Text="{Binding Values}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <WrapPanel Grid.Row="3"><Button Content="Poprzednie kursy" Click="PreviousRatesClick" IsEnabled="{Binding HasPreviousRates}"/><Button Content="Następne kursy" Click="NextRatesClick" IsEnabled="{Binding HasNextRates}"/><TextBlock Text="{Binding RatePageLabel}" VerticalAlignment="Center"/></WrapPanel>
          <TextBlock Grid.Row="4" Text="{Binding StoredRateDates}" TextWrapping="Wrap" Opacity="0.75"/>
        </Grid>
        <ScrollViewer Grid.Row="4" MaxHeight="230"><StackPanel Spacing="8">
          <Expander Header="Konflikty — wymagają świadomej decyzji" IsVisible="{Binding HasRateConflicts}"><StackPanel Spacing="6">
            <ListBox ItemsSource="{Binding RateConflicts}" SelectedItem="{Binding SelectedRateConflict, Mode=TwoWay}" MaxHeight="100" AutomationProperties.AutomationId="RateConflicts"/>
            <TextBlock Text="{Binding RateConflictComparison}" TextWrapping="Wrap"/>
            <StackPanel IsEnabled="{Binding CanResolveRates}"><CheckBox Content="Świadomie potwierdzam wybrany sposób rozstrzygnięcia" IsChecked="{Binding ConfirmRateResolution, Mode=TwoWay}" AutomationProperties.AutomationId="ConfirmRateResolution"/><WrapPanel><Button Content="Zachowaj zapisany kurs" Click="KeepRateClick" AutomationProperties.AutomationId="KeepRate"/><Button Content="Przyjmij propozycję NBP" Click="AcceptRateClick" AutomationProperties.AutomationId="AcceptRate"/></WrapPanel></StackPanel>
          </StackPanel></Expander>
          <Expander Header="Historia operacji walutowych"><StackPanel><WrapPanel><Button Content="Odśwież historię" Click="CurrencyHistoryClick"/><Button Content="Poprzednie" Click="PreviousCurrencyHistoryClick" IsEnabled="{Binding HasPreviousCurrencyHistory}"/><Button Content="Następne" Click="NextCurrencyHistoryClick" IsEnabled="{Binding HasNextCurrencyHistory}"/></WrapPanel><ListBox ItemsSource="{Binding CurrencyHistoryRows}" SelectedItem="{Binding SelectedCurrencyHistory, Mode=TwoWay}" MaxHeight="150" AutomationProperties.AutomationId="CurrencyHistory"/></StackPanel></Expander>
        </StackPanel></ScrollViewer>
      </Grid>
      <ScrollViewer IsVisible="{Binding IsGusSettings}">
        <StackPanel Spacing="12" MaxWidth="740" HorizontalAlignment="Left">
          <Button Content="Użytkownicy i uprawnienia" Click="UsersSettingsClick" AutomationProperties.AutomationId="OpenUsers"/>
          <Button Content="Bezpieczeństwo → Polityka haseł" Click="PasswordPolicyClick" AutomationProperties.AutomationId="OpenPasswordPolicy"/>
          <TextBlock Text="Ustawienia instalacji → Integracje zewnętrzne" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ComboBox SelectedIndex="{Binding RegistryServiceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RegistryService">
            <ComboBoxItem Content="GUS BIR1.2"/><ComboBoxItem Content="MF — wykaz VAT i WL2"/><ComboBoxItem Content="VIES"/>
          </ComboBox>
          <StackPanel DataContext="{Binding RegistrySettingsEditor}" x:DataType="vm:RegistryConfigurationEditor" Spacing="8">
            <TextBlock Text="{Binding Name}" FontSize="20"/>
            <TextBlock Text="Środowisko usługi"/>
            <ComboBox SelectedIndex="{Binding SelectedEnvironment, Mode=TwoWay}" AutomationProperties.AutomationId="RegistryMode"><ComboBoxItem Content="TEST"/><ComboBoxItem Content="PRODUKCJA"/></ComboBox>
            <TextBlock Text="Adres API — TEST"/><TextBox Text="{Binding TestUrl, Mode=TwoWay}" MaxLength="1024" AutomationProperties.AutomationId="RegistryTestUrl"/>
            <TextBlock Text="Adres API — PRODUKCJA"/><TextBox Text="{Binding ProductionUrl, Mode=TwoWay}" MaxLength="1024" AutomationProperties.AutomationId="RegistryProductionUrl"/>
            <StackPanel IsVisible="{Binding IsMf}" Spacing="8">
              <TextBlock Text="Adres WL2 — TEST"/><TextBox Text="{Binding TestWl2Url, Mode=TwoWay}" MaxLength="1024" AutomationProperties.AutomationId="RegistryTestWl2Url"/>
              <TextBlock Text="Adres WL2 — PRODUKCJA"/><TextBox Text="{Binding ProductionWl2Url, Mode=TwoWay}" MaxLength="1024" AutomationProperties.AutomationId="RegistryProductionWl2Url"/>
            </StackPanel>
            <CheckBox IsVisible="{Binding IsProduction}" IsChecked="{Binding ConfirmProduction, Mode=TwoWay}" AutomationProperties.AutomationId="ConfirmRegistryProduction">
              <TextBlock Text="Świadomie zatwierdzam PRODUKCJĘ. Kolejne zapytania tej usługi będą kierowane do rzeczywistego rejestru." TextWrapping="Wrap"/>
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Dozwolone są wyłącznie oficjalne adresy HTTPS danej usługi i środowiska. Zapis nie odpytuje rejestru. Zmiana obowiązuje dla nowych żądań bez restartu API." TextWrapping="Wrap"/>
          <WrapPanel><Button Content="Zapisz ustawienia usługi" Click="SaveRegistrySettingsClick" IsEnabled="{Binding CanSaveRegistryConfiguration}" AutomationProperties.AutomationId="SaveRegistrySettings"/><Button Content="Odśwież / porzuć zmiany ustawień" Click="RefreshRegistrySettingsClick" AutomationProperties.AutomationId="RefreshRegistrySettings"/></WrapPanel>
          <StackPanel IsVisible="{Binding IsGusServiceSelected}" Spacing="12">
          <TextBlock Text="GUS BIR — wspólny produkcyjny klucz API" FontSize="20"/>
          <TextBlock Text="Jeden produkcyjny klucz GUS BIR1.2 dla całej instalacji i wszystkich jej firm. Administrator uzyskuje własny klucz; VATowiec nie udostępnia klucza autora. Zapis nie zmienia środowiska ani nie odpytuje rejestru." TextWrapping="Wrap"/>
          <Button Content="https://api.stat.gov.pl/Home/RegonApi — jak uzyskać własny klucz" Click="GusWebsiteClick"/>
          <TextBlock Text="{Binding GusEnvironment}" TextWrapping="Wrap" AutomationProperties.AutomationId="GusEnvironment"/>
          <TextBlock Text="{Binding GusStatus}" FontSize="20" AutomationProperties.AutomationId="GusStatus"/>
          <TextBlock Text="Nowy produkcyjny klucz GUS (zapisany sekret nie jest nigdy wyświetlany)" TextWrapping="Wrap"/>
          <TextBox x:Name="GusKeyInput" PasswordChar="●" MaxLength="4096" IsEnabled="{Binding CanManageGus}" AutomationProperties.AutomationId="GusKey"/>
          <WrapPanel>
            <Button Content="Zapisz / zastąp klucz" Click="SaveGusKeyClick" IsEnabled="{Binding CanManageGus}" AutomationProperties.AutomationId="SaveGusKey"/>
            <Button Content="Usuń klucz…" Click="RequestGusDeleteClick" IsEnabled="{Binding CanDeleteGusKey}" AutomationProperties.AutomationId="DeleteGusKey"/>
            <Button Content="Odśwież stan" Click="RefreshGusStatusClick" AutomationProperties.AutomationId="RefreshGusStatus"/>
          </WrapPanel>
          <StackPanel IsVisible="{Binding ConfirmGusDelete}" Spacing="8">
            <TextBlock Text="Czy usunąć wspólny klucz produkcyjny GUS? Dotyczy to wszystkich firm tej instalacji. MF, VIES i DataPort nadal działają niezależnie." TextWrapping="Wrap"/>
            <WrapPanel><Button Content="Potwierdzam usunięcie" Click="DeleteGusKeyClick" AutomationProperties.AutomationId="ConfirmDeleteGusKey"/><Button Content="Anuluj" Click="CancelGusDeleteClick"/></WrapPanel>
          </StackPanel>
          <TextBlock Text="Po przeniesieniu instalacji lub utracie ochrony kryptograficznej wpisz klucz ponownie. Sama kopia bazy SQL nie wystarcza do odszyfrowania sekretu." TextWrapping="Wrap"/>
          </StackPanel>
          <WrapPanel><Button Content="Wróć" Click="CloseGusSettingsClick" AutomationProperties.AutomationId="CloseGusSettings"/><Button Content="Wyloguj" Click="LogoutClick"/></WrapPanel>
        </StackPanel>
      </ScrollViewer>
      <desktop:UserAdministrationView IsVisible="{Binding IsUsersSettings}"/>
      <ScrollViewer IsVisible="{Binding IsPasswordPolicyScreen}">
        <StackPanel MaxWidth="740" HorizontalAlignment="Left" Spacing="14">
          <TextBlock Text="Ustawienia instalacji → Bezpieczeństwo → Polityka haseł" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="Wspólne wymagania dla wszystkich użytkowników i firm. Zmiana obowiązuje przy następnym ustawieniu hasła; nie zmienia dotychczasowych haseł i nie wylogowuje użytkowników." TextWrapping="Wrap"/>
          <TextBlock IsVisible="{Binding !HasPasswordPolicy}" Text="Nie wczytano konfiguracji z bazy systemowej instalacji. Formularz pozostaje niedostępny; sprawdź komunikat i wybierz Odśwież." TextWrapping="Wrap" AutomationProperties.AutomationId="PasswordPolicyNotLoaded"/>
          <Border IsVisible="{Binding HasPasswordPolicy}">
          <StackPanel DataContext="{Binding PasswordPolicyEditor}" x:DataType="vm:PasswordPolicyEditor" Spacing="12">
            <CheckBox Content="Włącz politykę złożoności haseł" IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="PasswordPolicyEnabled"/>
            <StackPanel IsEnabled="{Binding IsEnabled}" Spacing="10">
              <TextBlock Text="Minimalna długość hasła"/>
              <NumericUpDown Minimum="1" Maximum="1024" Increment="1" FormatString="0" Value="{Binding MinimumLength, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="PasswordMinimumLength"/>
              <CheckBox Content="Wymagaj wielkiej litery" IsChecked="{Binding RequireUppercase, Mode=TwoWay}" AutomationProperties.AutomationId="PasswordRequireUppercase"/>
              <CheckBox Content="Wymagaj małej litery" IsChecked="{Binding RequireLowercase, Mode=TwoWay}" AutomationProperties.AutomationId="PasswordRequireLowercase"/>
              <CheckBox Content="Wymagaj cyfry" IsChecked="{Binding RequireDigit, Mode=TwoWay}" AutomationProperties.AutomationId="PasswordRequireDigit"/>
              <CheckBox Content="Wymagaj znaku specjalnego" IsChecked="{Binding RequireSpecialCharacter, Mode=TwoWay}" AutomationProperties.AutomationId="PasswordRequireSpecial"/>
            </StackPanel>
            <TextBlock IsVisible="{Binding !IsEnabled}" Text="Uwaga: złożoność wyłączona. Każde niepuste hasło spełnia reguły długości i klas znaków. Historia i ważność nadal obowiązują, jeśli je włączono. Zapis wymaga potwierdzenia." Foreground="#B42318" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Status}" Foreground="#9A6700" AutomationProperties.AutomationId="PasswordPolicyStatus"/>
            <Separator/>
            <CheckBox Content="Nie pozwalaj ponownie używać poprzednich haseł" IsChecked="{Binding PreventPasswordReuse, Mode=TwoWay}" AutomationProperties.AutomationId="PreventPasswordReuse"/>
            <TextBlock Text="Liczba poprzednich haseł (oprócz aktualnego)"/>
            <NumericUpDown Minimum="1" Maximum="20" FormatString="0" Value="{Binding PreviousPasswordCount, Mode=TwoWay}" IsEnabled="{Binding PreventPasswordReuse}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="PreviousPasswordCount"/>
            <CheckBox Content="Wymuszaj okresową zmianę hasła" IsChecked="{Binding EnforcePasswordExpiration, Mode=TwoWay}" AutomationProperties.AutomationId="EnforcePasswordExpiration"/>
            <TextBlock Text="Ważność hasła w dniach"/>
            <NumericUpDown Minimum="1" Maximum="3650" FormatString="0" Value="{Binding PasswordValidityDays, Mode=TwoWay}" IsEnabled="{Binding EnforcePasswordExpiration}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="PasswordValidityDays"/>
            <TextBlock Text="Historia i ważność działają niezależnie od złożoności. Po włączeniu ważności bieżące konta otrzymują pełny okres na zmianę hasła." TextWrapping="Wrap"/>
          </StackPanel>
          </Border>
          <WrapPanel><Button Content="Zapisz politykę haseł" Click="SavePasswordPolicyClick" IsEnabled="{Binding CanSavePasswordPolicy}" AutomationProperties.AutomationId="SavePasswordPolicy"/><Button Content="Odśwież" Click="RefreshPasswordPolicyClick" AutomationProperties.AutomationId="RefreshPasswordPolicy"/><Button Content="Wróć" Click="ClosePasswordPolicyClick" AutomationProperties.AutomationId="ClosePasswordPolicy"/></WrapPanel>
          <TextBlock Text="Historia zmian polityki" FontSize="18"/>
          <TextBlock IsVisible="{Binding !HasPolicyHistory}" Text="Historia zmian nie została wczytana." AutomationProperties.AutomationId="PasswordPolicyHistoryNotLoaded"/>
          <TextBlock IsVisible="{Binding IsPolicyHistoryEmpty}" Text="Nie ma zapisanych zmian polityki haseł."/>
          <Button Content="Odśwież historię" Click="PolicyHistoryRefreshClick" AutomationProperties.AutomationId="RefreshPolicyHistory"/>
          <ItemsControl ItemsSource="{Binding PasswordPolicyHistory}" AutomationProperties.AutomationId="PasswordPolicyHistory"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PasswordPolicyHistoryRow">
            <StackPanel Spacing="4" Margin="0,0,0,14"><TextBlock Text="{Binding Time}" FontWeight="SemiBold"/><TextBlock Text="{Binding Actor}"/><TextBlock Text="{Binding Before}" TextWrapping="Wrap"/><TextBlock Text="{Binding After}" TextWrapping="Wrap"/></StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel><Button Content="Nowsze" Click="PolicyHistoryPreviousClick" IsEnabled="{Binding PolicyHistoryHasPrevious}"/><Button Content="Starsze" Click="PolicyHistoryNextClick" IsEnabled="{Binding PolicyHistoryHasNext}"/></WrapPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer IsVisible="{Binding IsOwnPasswordChange}">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left" Spacing="12" Margin="0,20">
          <TextBlock Text="Ustaw własne hasło" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Wpisz bieżące (lub tymczasowe) i nowe hasło. Po zapisie wszystkie sesje zostaną unieważnione. Zaloguj się ponownie nowym hasłem." TextWrapping="Wrap"/>
          <TextBlock Text="Bieżące hasło"/><TextBox x:Name="OwnCurrentPassword" PasswordChar="●" MaxLength="1024" AutomationProperties.AutomationId="CurrentPassword"/>
          <TextBlock Text="Nowe hasło"/><TextBox x:Name="OwnNewPassword" PasswordChar="●" MaxLength="1024" AutomationProperties.AutomationId="NewPassword"/>
          <TextBlock Text="Powtórz nowe hasło"/><TextBox x:Name="OwnRepeatPassword" PasswordChar="●" MaxLength="1024" KeyDown="OwnPasswordKeyDown" AutomationProperties.AutomationId="RepeatPassword"/>
          <TextBlock Text="Obowiązują aktualne wymagania haseł ustawione dla instalacji. Hasło nie może być puste." TextWrapping="Wrap"/>
          <WrapPanel><Button Content="Zmień hasło" Click="ChangeOwnPasswordClick" AutomationProperties.AutomationId="SaveOwnPassword"/><Button Content="Anuluj" Click="CancelOwnPasswordClick" IsVisible="{Binding CanCancelPasswordChange}"/><Button Content="Wyloguj" Click="LogoutClick"/></WrapPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer IsVisible="{Binding IsDataPortSettings}">
        <StackPanel Spacing="12" MaxWidth="740" HorizontalAlignment="Left">
          <Button Content="Ustawienia firmy → Waluty i kursy NBP" Click="CurrencySettingsClick" IsVisible="{Binding CanViewRates}" AutomationProperties.AutomationId="CurrencySettings"/><TextBlock Text="Ustawienia firmy → Integracje zewnętrzne → DataPort" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CurrentCompany}" TextWrapping="Wrap"/>
          <TextBlock Text="DataPort to komercyjny pośrednik danych GUS. Samodzielnie załóż konto i uzyskaj klucz. Zapytania są ręczne, a limit dzienny wspólny dla całego konta (reset 00:00 UTC). Dane mogą pochodzić z cache." TextWrapping="Wrap"/>
          <Button Content="https://dataport.pl/api — dokumentacja i konto" Click="DataPortWebsiteClick"/>
          <TextBlock Text="{Binding DataPortStatus}" FontSize="20" AutomationProperties.AutomationId="DataPortStatus"/>
          <TextBlock Text="{Binding DataPortPermission}" TextWrapping="Wrap"/>
          <TextBlock Text="Nowy klucz API (zapisana wartość nigdy nie jest odczytywana do programu)" TextWrapping="Wrap"/>
          <TextBox x:Name="DataPortKeyInput" PasswordChar="●" MaxLength="4096" IsEnabled="{Binding CanManageCompanyIntegrations}" AutomationProperties.AutomationId="DataPortKey"/>
          <WrapPanel>
            <Button Content="Zapisz / zastąp klucz" Click="SaveDataPortKeyClick" IsEnabled="{Binding CanManageCompanyIntegrations}" AutomationProperties.AutomationId="SaveDataPortKey"/>
            <Button Content="Usuń klucz…" Click="RequestDataPortDeleteClick" IsEnabled="{Binding CanDeleteDataPortKey}" AutomationProperties.AutomationId="DeleteDataPortKey"/>
            <Button Content="Odśwież stan" Click="RefreshDataPortStatusClick" AutomationProperties.AutomationId="RefreshDataPortStatus"/>
          </WrapPanel>
          <StackPanel IsVisible="{Binding ConfirmDataPortDelete}" Spacing="8">
            <TextBlock Text="Czy usunąć klucz DataPort tej firmy? Kolejne zapytania będą wymagały ponownego wpisania klucza." TextWrapping="Wrap"/>
            <WrapPanel><Button Content="Potwierdzam usunięcie" Click="DeleteDataPortKeyClick" AutomationProperties.AutomationId="ConfirmDeleteDataPortKey"/><Button Content="Anuluj" Click="CancelDataPortDeleteClick"/></WrapPanel>
          </StackPanel>
          <Button Content="Wróć do kartoteki" Click="CloseDataPortSettingsClick" AutomationProperties.AutomationId="CloseCompanySettings"/>
        </StackPanel>
      </ScrollViewer>
      <Grid IsVisible="{Binding IsEditing}" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding CurrentCompany}" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding RegistryEnvironmentLabel}" TextWrapping="Wrap" Foreground="#8A5A00" FontWeight="SemiBold" AutomationProperties.AutomationId="RegistryEnvironment"/>
          <TextBlock IsVisible="{Binding !CanEditContractors}" Text="Tryb tylko do odczytu — brak uprawnienia edycji w tej firmie." Foreground="#8A5A00" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CurrentContractor}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="CurrentContractor"/>
          <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Height="48" AutomationProperties.AutomationId="ContractorTabs">
            <TabItem Header="Dane główne"/><TabItem Header="Adresy"/><TabItem Header="Kontakty"/><TabItem Header="Rachunki bankowe"/><TabItem Header="Weryfikacje"/><TabItem Header="Finansowe"/>
          </TabControl>
        </StackPanel>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsMainTab}" HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="0,0,16,8">
            <StackPanel Spacing="10" IsEnabled="{Binding !HasConflict}">
<StackPanel Spacing="4"><TextBlock Text="Kod *"/><TextBox Text="{Binding Editor.Code, Mode=TwoWay}" MaxLength="64" IsReadOnly="{Binding !CanEditContractors}" x:Name="ContractorCodeInput" AutomationProperties.AutomationId="ContractorCode"/><TextBlock Text="{Binding Editor.CodeError}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Pełna nazwa *"/><TextBox Text="{Binding Editor.Name, Mode=TwoWay}" MaxLength="256" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorName"/><TextBlock Text="{Binding Editor.NameError}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Kraj *"/><TextBox Text="{Binding Editor.CountryCode, Mode=TwoWay}" MaxLength="2" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorCountryCode"/><TextBlock Text="{Binding Editor.CountryError}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="TaxId — krajowy identyfikator podatkowy (opcjonalny)"/><TextBox Text="{Binding Editor.TaxId, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorTaxId"/><TextBlock Text="{Binding Editor.TaxIdError}" Foreground="#B42318"/><TextBlock Text="{Binding TaxIdAssessment}" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="VatEuId — pełny numer VAT UE z prefiksem (opcjonalny)"/><TextBox Text="{Binding Editor.VatEuId, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorVatEuId"/><TextBlock Text="{Binding Editor.VatEuIdError}" Foreground="#B42318"/><TextBlock Text="{Binding VatEuIdAssessment}" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="KsefIdWew — pełny IDWew nadany w KSeF (opcjonalny)"/><TextBox Text="{Binding Editor.KsefIdWew, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorKsefIdWew"/><TextBlock Text="{Binding Editor.KsefIdWewError}" Foreground="#B42318"/><TextBlock Text="{Binding KsefIdWewAssessment}" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="REGON (9 lub 14 cyfr, opcjonalny)"/><TextBox Text="{Binding Editor.Regon, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorRegon"/><TextBlock Text="{Binding RegonAssessment}" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="KRS (10 cyfr, opcjonalny)"/><TextBox Text="{Binding Editor.Krs, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorKrs"/><TextBlock Text="{Binding KrsAssessment}" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="BDO (9 cyfr, opcjonalny)"/><TextBox Text="{Binding Editor.Bdo, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorBdo"/><TextBlock Text="{Binding BdoAssessment}" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding CanManagePesel}"><TextBlock Text="PESEL (dane chronione, opcjonalny)"/><TextBox Text="{Binding Editor.Pesel, Mode=TwoWay}" MaxLength="100" IsReadOnly="{Binding !CanEditContractors}" AutomationProperties.AutomationId="ContractorPesel"/><TextBlock Text="{Binding PeselAssessment}" TextWrapping="Wrap"/></StackPanel>
              <TextBlock Text="{Binding Editor.StandardIdentifierErrors}" Foreground="#B42318" TextWrapping="Wrap"/>
              <Button Content="Normalizuj i sprawdź identyfikatory" Click="ValidateIdentifiersClick" IsEnabled="{Binding CanEditContractors}" AutomationProperties.AutomationId="ValidateIdentifiers"/>
              <TextBlock Text="Kontrola lokalna nie potwierdza rejestracji podatnika. Wyniki dotyczą pokazanego sprawdzenia; po zmianie pól sprawdź ponownie." TextWrapping="Wrap" Opacity="0.75"/>
              <WrapPanel IsEnabled="{Binding CanVerify}"><Button Content="Pobierz dane z GUS" Click="GusClick" AutomationProperties.AutomationId="VerifyGus"/><Button Content="Sprawdź VAT UE" Click="ViesClick" AutomationProperties.AutomationId="VerifyVies"/><Button Content="Sprawdź podatnika VAT" Click="MfTaxpayerClick" AutomationProperties.AutomationId="VerifyMfTaxpayer"/><Button Content="Status VAT (WL2)" Click="MfStatusClick" AutomationProperties.AutomationId="VerifyMfStatus"/></WrapPanel>
              <TextBlock Text="Data stanu wykazu MF (także rachunku)"/><DatePicker SelectedDate="{Binding VerificationDate, Mode=TwoWay}" AutomationProperties.AutomationId="VerificationDate"/>
              <CheckBox Content="Aktywny" IsChecked="{Binding Editor.IsActive, Mode=TwoWay}" IsEnabled="{Binding CanEditContractors}" AutomationProperties.AutomationId="ContractorActive"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock Text="Kontrahent nadrzędny / grupa" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ParentLabel}" TextWrapping="Wrap" AutomationProperties.AutomationId="ParentLabel"/>
              <TextBlock Text="{Binding Editor.ParentError}" Foreground="#B42318" TextWrapping="Wrap"/>
              <TextBlock Text="Grupowanie nie dziedziczy danych i nie określa podmiotu podatkowego." TextWrapping="Wrap" Opacity="0.75"/>
              <StackPanel Spacing="8" IsEnabled="{Binding CanEditContractors}">
                <TextBox Text="{Binding ParentSearch, Mode=TwoWay}" MaxLength="128" PlaceholderText="Szukaj po kodzie lub nazwie" AutomationProperties.AutomationId="ParentSearch"/>
                <WrapPanel><Button Content="Szukaj grupy" Click="SearchParentsClick" AutomationProperties.AutomationId="SearchParents"/><Button Content="Usuń powiązanie" Click="ClearParentClick" AutomationProperties.AutomationId="ClearParent"/></WrapPanel>
                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding ParentCandidates}" SelectedItem="{Binding SelectedParentCandidate, Mode=TwoWay}" Height="120" AutomationProperties.AutomationId="ParentCandidates"><ListBox.ItemTemplate><DataTemplate x:DataType="contracts:ContractorResponse"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                <WrapPanel><Button Content="Wybierz nadrzędnego" Click="ChooseParentClick" AutomationProperties.AutomationId="ChooseParent"/><Button Content="Poprzednie wyniki" Click="PreviousParentsClick" IsEnabled="{Binding HasPreviousParents}"/><Button Content="Następne wyniki" Click="NextParentsClick" IsEnabled="{Binding HasNextParents}"/></WrapPanel>
              </StackPanel>
              <TextBlock Text="Podmioty należące do tej grupy" FontSize="18" FontWeight="SemiBold"/>
              <ListBox ItemsSource="{Binding ChildContractors}" SelectedItem="{Binding SelectedChild, Mode=TwoWay}" Height="140" DoubleTapped="ChildDoubleTapped" AutomationProperties.AutomationId="ChildContractors"/>
              <WrapPanel><Button Content="Otwórz podmiot" Click="OpenChildClick"/><Button Content="Poprzednie" Click="PreviousChildrenClick" IsEnabled="{Binding HasPreviousChildren}"/><Button Content="Następne" Click="NextChildrenClick" IsEnabled="{Binding HasNextChildren}"/></WrapPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1" IsVisible="{Binding IsDetailTab}" ColumnDefinitions="340,*" ColumnSpacing="16">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8">
            <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel IsVisible="{Binding IsBankTab}" Spacing="5"><TextBlock Text="Wybierz zapisany rachunek i datę stanu. NRB lub IBAN PL; wynik nie jest bezterminowym potwierdzeniem." TextWrapping="Wrap"/><DatePicker SelectedDate="{Binding VerificationDate, Mode=TwoWay}"/><Button Content="Sprawdź rachunek w wykazie VAT" Click="MfAccountClick" IsEnabled="{Binding CanVerify}" AutomationProperties.AutomationId="VerifyMfAccount"/></StackPanel>
            <TextBlock IsVisible="{Binding !HasSavedContractor}" Text="Najpierw zapisz dane główne nowego kontrahenta, a następnie otwórz jego kartotekę." TextWrapping="Wrap"/>
            <WrapPanel IsEnabled="{Binding HasSavedContractor}">
              <Button Content="Nowy (Ctrl+N)" Click="NewDetailClick" IsVisible="{Binding CanEditDetails}" AutomationProperties.AutomationId="NewDetail"/>
              <Button Content="Otwórz (F2)" Click="EditDetailClick" AutomationProperties.AutomationId="EditDetail"/>
              <Button Content="Odśwież" Click="RefreshDetailsClick" AutomationProperties.AutomationId="RefreshDetails"/>
            </WrapPanel>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding DetailRows}" SelectedItem="{Binding SelectedDetail, Mode=TwoWay}" Height="220" DoubleTapped="DetailDoubleTapped" AutomationProperties.AutomationId="DetailRows"><ListBox.ItemTemplate><DataTemplate x:DataType="contracts:DetailResponse"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
            <WrapPanel IsEnabled="{Binding !IsDetailEditing}"><Button Content="Poprzednia" Click="PreviousDetailsClick" IsEnabled="{Binding HasPreviousDetails}"/><TextBlock Text="{Binding DetailPage}" Margin="8"/><Button Content="Następna" Click="NextDetailsClick" IsEnabled="{Binding HasNextDetails}"/></WrapPanel>
            <StackPanel IsVisible="{Binding IsAddressesTab}" IsEnabled="{Binding CanEditDetails}" Spacing="6">
              <TextBlock Text="Nowy rodzaj adresu"/>
              <TextBox Text="{Binding NewAddressTypeName, Mode=TwoWay}" MaxLength="100" AutomationProperties.AutomationId="NewAddressTypeName"/>
              <Button Content="Dodaj rodzaj" Click="AddAddressTypeClick" AutomationProperties.AutomationId="AddAddressType"/>
            </StackPanel>
            <TextBlock Text="{Binding CurrentCompany}" TextWrapping="Wrap" Opacity="0.7"/>
          </StackPanel></ScrollViewer>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel IsVisible="{Binding IsDetailEditing}" Spacing="10" Margin="0,0,16,8" IsEnabled="{Binding CanEditDetails}">
              <StackPanel IsEnabled="{Binding !HasDetailConflict}" Spacing="10">
                <StackPanel IsVisible="{Binding IsAddressesTab}" Spacing="4"><TextBlock Text="Rodzaj adresu *"/><ComboBox ItemsSource="{Binding AddressTypes}" SelectedItem="{Binding SelectedAddressType, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DetailAddressType"/><TextBlock Text="{Binding DetailEditor.Errors[AddressTypeId]}" Foreground="#B42318"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Nazwa (wymagana tylko dla kontaktu)"/><TextBox Text="{Binding DetailEditor.Name, Mode=TwoWay}" MaxLength="{Binding DetailNameMaxLength}" AutomationProperties.AutomationId="DetailName"/><TextBlock Text="{Binding DetailEditor.Errors[Name]}" Foreground="#B42318"/></StackPanel>
                <StackPanel IsVisible="{Binding IsContactsTab}" Spacing="10">
<StackPanel Spacing="4"><TextBlock Text="Stanowisko/funkcja"/><TextBox Text="{Binding DetailEditor.Position, Mode=TwoWay}" MaxLength="100" AutomationProperties.AutomationId="DetailPosition"/><TextBlock Text="{Binding DetailEditor.Errors[Position]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="E-mail (opcjonalnie)"/><TextBox Text="{Binding DetailEditor.Email, Mode=TwoWay}" MaxLength="256" AutomationProperties.AutomationId="DetailEmail"/><TextBlock Text="{Binding DetailEditor.Errors[Email]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Telefon (opcjonalnie)"/><TextBox Text="{Binding DetailEditor.Phone, Mode=TwoWay}" MaxLength="100" AutomationProperties.AutomationId="DetailPhone"/><TextBlock Text="{Binding DetailEditor.Errors[Phone]}" Foreground="#B42318"/></StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsPostalDetail}" Spacing="10">
<StackPanel Spacing="4"><TextBlock Text="Ulica"/><TextBox Text="{Binding DetailEditor.Street, Mode=TwoWay}" MaxLength="200" AutomationProperties.AutomationId="DetailStreet"/><TextBlock Text="{Binding DetailEditor.Errors[Street]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Numer budynku"/><TextBox Text="{Binding DetailEditor.BuildingNo, Mode=TwoWay}" MaxLength="20" AutomationProperties.AutomationId="DetailBuildingNo"/><TextBlock Text="{Binding DetailEditor.Errors[BuildingNo]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Numer lokalu"/><TextBox Text="{Binding DetailEditor.ApartmentNo, Mode=TwoWay}" MaxLength="20" AutomationProperties.AutomationId="DetailApartmentNo"/><TextBlock Text="{Binding DetailEditor.Errors[ApartmentNo]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Kod pocztowy"/><TextBox Text="{Binding DetailEditor.PostalCode, Mode=TwoWay}" MaxLength="20" AutomationProperties.AutomationId="DetailPostalCode"/><TextBlock Text="{Binding DetailEditor.Errors[PostalCode]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Miejscowość"/><TextBox Text="{Binding DetailEditor.City, Mode=TwoWay}" MaxLength="150" AutomationProperties.AutomationId="DetailCity"/><TextBlock Text="{Binding DetailEditor.Errors[City]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Kraj (dwie litery, opcjonalnie)"/><TextBox Text="{Binding DetailEditor.CountryCode, Mode=TwoWay}" MaxLength="2" AutomationProperties.AutomationId="DetailCountryCode"/><TextBlock Text="{Binding DetailEditor.Errors[CountryCode]}" Foreground="#B42318"/></StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsAddressesTab}" Spacing="4"><TextBlock Text="Województwo/region"/><TextBox Text="{Binding DetailEditor.Region, Mode=TwoWay}" MaxLength="100" AutomationProperties.AutomationId="DetailRegion"/><TextBlock Text="{Binding DetailEditor.Errors[Region]}" Foreground="#B42318"/></StackPanel>
                <StackPanel IsVisible="{Binding IsBankTab}" Spacing="10">
                  <TextBlock Text="Kontrola formatu i sumy kontrolnej. Nie potwierdza istnienia rachunku, właściciela, banku ani BIC." TextWrapping="Wrap" Opacity="0.75"/>
<StackPanel Spacing="4"><TextBlock Text="Numer rachunku *"/><TextBox Text="{Binding DetailEditor.AccountNumber, Mode=TwoWay}" MaxLength="100" AutomationProperties.AutomationId="DetailAccountNumber"/><TextBlock Text="{Binding DetailEditor.Errors[AccountNumber]}" Foreground="#B42318"/></StackPanel>
                  <Button Content="Sprawdź numer" Click="ValidateBankAccountClick" AutomationProperties.AutomationId="ValidateBankAccount"/>
                  <TextBlock Text="{Binding BankValidationMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="BankValidationStatus"/>
                  <TextBlock Text="{Binding BankLookupMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="BankLookupStatus"/>
                  <StackPanel IsVisible="{Binding HasBankNameProposal}" Spacing="4">
                    <TextBlock Text="{Binding BankNameProposal}" TextWrapping="Wrap" AutomationProperties.AutomationId="BankNameProposal"/>
                    <Button Content="Zastąp nazwę banku propozycją NBP" Click="ApplyBankNameClick" AutomationProperties.AutomationId="ApplyBankName"/>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding HasBicProposal}" Spacing="4">
                    <TextBlock Text="Propozycje BIC z NBP EWIB (wybór nie zmienia pola do zatwierdzenia):" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding BankBicChoices}" SelectedItem="{Binding SelectedBankBic, Mode=TwoWay}" AutomationProperties.AutomationId="BankBicChoices"/>
                    <Button Content="Użyj wybranego BIC" Click="ApplyBankBicClick" IsEnabled="{Binding CanApplyBankBic}" AutomationProperties.AutomationId="ApplyBankBic"/>
                  </StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Nazwa banku"/><TextBox Text="{Binding DetailEditor.BankName, Mode=TwoWay}" MaxLength="200" AutomationProperties.AutomationId="DetailBankName"/><TextBlock Text="{Binding DetailEditor.Errors[BankName]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="BIC/SWIFT"/><TextBox Text="{Binding DetailEditor.Bic, Mode=TwoWay}" MaxLength="11" AutomationProperties.AutomationId="DetailBic"/><TextBlock Text="{Binding DetailEditor.Errors[Bic]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Waluta (trzy litery; puste = bez waluty)"/><TextBox Text="{Binding DetailEditor.CurrencyCode, Mode=TwoWay}" MaxLength="3" AutomationProperties.AutomationId="DetailCurrencyCode"/><TextBlock Text="{Binding DetailEditor.Errors[CurrencyCode]}" Foreground="#B42318"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Właściciel rachunku"/><TextBox Text="{Binding DetailEditor.AccountHolderName, Mode=TwoWay}" MaxLength="256" AutomationProperties.AutomationId="DetailAccountHolderName"/><TextBlock Text="{Binding DetailEditor.Errors[AccountHolderName]}" Foreground="#B42318"/></StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding !IsContactsTab}" Spacing="6">
                  <CheckBox Content="Preferowany / domyślny w tej grupie" IsChecked="{Binding DetailEditor.IsDefault, Mode=TwoWay}" AutomationProperties.AutomationId="DetailDefault"/>
                  <CheckBox Content="Aktywny" IsChecked="{Binding DetailEditor.IsActive, Mode=TwoWay}" AutomationProperties.AutomationId="DetailActive"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding !IsAddressesTab}" Spacing="4"><TextBlock Text="Uwagi"/><TextBox Text="{Binding DetailEditor.Notes, Mode=TwoWay}" AcceptsReturn="True" MinHeight="70" AutomationProperties.AutomationId="DetailNotes"/></StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsFinanceTab}" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FinanceScroll">
          <StackPanel MaxWidth="860" Spacing="16" Margin="0,0,16,12" AutomationProperties.AutomationId="FinanceForm">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="6">
                <TextBlock Text="Warunki finansowe" FontSize="21" FontWeight="SemiBold"/>
                <ComboBox SelectedIndex="{Binding FinanceDirectionIndex, Mode=OneWay}" SelectionChanged="FinanceDirectionSelectionChanged" HorizontalAlignment="Left" MinWidth="320" TabIndex="0" AutomationProperties.AutomationId="FinanceDirection"><ComboBoxItem Content="Sprzedaż — nasze warunki dla klienta"/><ComboBoxItem Content="Zakup — warunki dostawcy dla nas"/></ComboBox>
              </StackPanel>
              <Button Grid.Column="1" Content="Odśwież" Click="RefreshFinanceClick" IsEnabled="{Binding HasSavedContractor}" VerticalAlignment="Bottom" TabIndex="99" AutomationProperties.AutomationId="RefreshFinance" ToolTip.Tip="Wczytaj aktualne finanse i słowniki. Niezapisane szkice wymagają potwierdzenia."/>
            </Grid>
            <TextBlock Text="Ustawienia do przyszłych dokumentów. Puste pole = brak indywidualnego ustawienia; waluta nie jest automatycznie PLN. Zapis finansów nie zapisuje szkicu danych głównych." TextWrapping="Wrap" Opacity="0.75"/>
            <TextBlock IsVisible="{Binding !HasSavedContractor}" Text="Najpierw zapisz nowego kontrahenta w zakładce Dane główne." TextWrapping="Wrap" Foreground="#8A5A00"/>
            <TextBlock IsVisible="{Binding HasUnknownTradeCodes}" Text="{Binding FinanceLookupWarning}" TextWrapping="Wrap" Foreground="#8A5A00" AutomationProperties.AutomationId="FinanceLookupWarning"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="14" IsEnabled="{Binding CanEditFinance}">
              <StackPanel Spacing="5"><TextBlock Text="Termin płatności (dni)"/><TextBox Text="{Binding TradeTermsEditor.Days, Mode=TwoWay}" Width="140" HorizontalAlignment="Left" MaxLength="10" PlaceholderText="0–3650" TabIndex="10" AutomationProperties.AutomationId="TradePaymentDays"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Sposób płatności"/><ComboBox ItemsSource="{Binding TradePaymentChoices}" SelectedItem="{Binding SelectedTradePayment, Mode=OneWay}" SelectionChanged="TradePaymentSelectionChanged" HorizontalAlignment="Stretch" TabIndex="20" AutomationProperties.AutomationId="TradePaymentMethod"/></StackPanel>
              <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="Domyślna waluta"/><ComboBox ItemsSource="{Binding TradeCurrencyChoices}" SelectedItem="{Binding SelectedTradeCurrency, Mode=OneWay}" SelectionChanged="TradeCurrencySelectionChanged" HorizontalAlignment="Stretch" TabIndex="30" AutomationProperties.AutomationId="TradeCurrency"><ComboBox.Styles><Style Selector="ComboBoxItem" x:DataType="contracts:FinanceCurrency"><Setter Property="IsEnabled" Value="{Binding IsActive}"/></Style></ComboBox.Styles></ComboBox></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Domyślny rabat (%)"/><TextBox Text="{Binding TradeTermsEditor.Discount, Mode=TwoWay}" Width="140" HorizontalAlignment="Left" MaxLength="20" PlaceholderText="0–100" TabIndex="40" AutomationProperties.AutomationId="TradeDiscount"/></StackPanel>
            </Grid>
            <StackPanel Spacing="6" IsEnabled="{Binding CanEditFinance}">
              <TextBlock Text="Uwagi handlowe"/><TextBox Text="{Binding TradeTermsEditor.Notes, Mode=TwoWay}" MaxLength="2000" AcceptsReturn="True" MinHeight="76" MaxHeight="140" TabIndex="50" AutomationProperties.AutomationId="TradeNotes"/>
            </StackPanel>
            <WrapPanel><Button Content="Zapisz warunki (Ctrl+S)" Click="SaveTermsClick" IsEnabled="{Binding CanSaveTradeTerms}" TabIndex="60" AutomationProperties.AutomationId="SaveTradeTerms"/><Button Content="Anuluj zmiany warunków" Click="CancelTermsClick" IsEnabled="{Binding CanEditFinance}" TabIndex="61" AutomationProperties.AutomationId="CancelTradeTerms"/></WrapPanel>
            <Border BorderBrush="#D0D5DD" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Spacing="8">
            <TextBlock Text="Limity kupieckie według waluty" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Kwoty nie są wykorzystaniem limitu ani saldem. Zapis nie blokuje sprzedaży i nie przelicza walut." TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="170,*,140" Margin="12,0"><TextBlock Text="Waluta" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Kwota limitu" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold"/></Grid>
            <ListBox ItemsSource="{Binding CreditLimits}" SelectedItem="{Binding SelectedCreditLimit, Mode=TwoWay}" MinHeight="70" MaxHeight="180" TabIndex="70" AutomationProperties.AutomationId="CreditLimits">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
              <ListBox.ItemTemplate><DataTemplate x:DataType="contracts:CreditLimitResponse"><Grid ColumnDefinitions="170,*,140" Margin="4"><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource FinanceCurrencyLabel}"><Binding Path="CurrencyCode"/><Binding Path="$parent[Window].((vm:MainViewModel)DataContext).FinanceCurrencies"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:0.########}'}"/><TextBlock Grid.Column="2" IsVisible="{Binding IsActive}" Text="Aktywny"/><TextBlock Grid.Column="2" IsVisible="{Binding !IsActive}" Text="Nieaktywny"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel><Button Content="Poprzednie" Click="PreviousLimitsClick" IsEnabled="{Binding HasPreviousCreditLimits}"/><TextBlock Text="{Binding CreditLimitPage}" VerticalAlignment="Center"/><Button Content="Następne" Click="NextLimitsClick" IsEnabled="{Binding HasNextCreditLimits}"/></WrapPanel>
            <WrapPanel IsEnabled="{Binding CanEditFinance}"><Button Content="Nowy limit (Ctrl+N)" Click="NewLimitClick" AutomationProperties.AutomationId="NewCreditLimit"/><Button Content="Edytuj limit / dezaktywuj (F2)" Click="EditLimitClick" AutomationProperties.AutomationId="EditCreditLimit"/></WrapPanel>
            <Border IsVisible="{Binding IsCreditLimitEditing}" BorderBrush="#999999" BorderThickness="1" Padding="12">
              <StackPanel Spacing="8" IsEnabled="{Binding CanEditFinance}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24"><StackPanel Spacing="5"><TextBlock Text="Waluta limitu"/><ComboBox ItemsSource="{Binding LimitCurrencyChoices}" SelectedItem="{Binding SelectedLimitCurrency, Mode=OneWay}" SelectionChanged="LimitCurrencySelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="LimitCurrency"><ComboBox.Styles><Style Selector="ComboBoxItem" x:DataType="contracts:FinanceCurrency"><Setter Property="IsEnabled" Value="{Binding IsActive}"/></Style></ComboBox.Styles></ComboBox></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Kwota limitu"/><TextBox Text="{Binding CreditLimitEditor.Amount, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" MaxLength="32" AutomationProperties.AutomationId="LimitAmount"/></StackPanel></Grid>
                <CheckBox Content="Limit aktywny" IsChecked="{Binding CreditLimitEditor.IsActive, Mode=TwoWay}" AutomationProperties.AutomationId="LimitActive"/><WrapPanel><Button Content="Zapisz limit" Click="SaveLimitClick" IsEnabled="{Binding CanSaveFinance}" AutomationProperties.AutomationId="SaveCreditLimit"/><Button Content="Anuluj szkic limitu" Click="CancelLimitClick" AutomationProperties.AutomationId="CancelCreditLimit"/></WrapPanel>
              </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            <Expander Header="Słownik sposobów płatności">
              <StackPanel Spacing="8"><ListBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}" MaxHeight="180" AutomationProperties.AutomationId="PaymentMethods"/><WrapPanel IsEnabled="{Binding CanEditFinance}"><Button Content="Nowy sposób" Click="NewPaymentMethodClick" AutomationProperties.AutomationId="NewPaymentMethod"/><Button Content="Edytuj nazwę / aktywność" Click="EditPaymentMethodClick" AutomationProperties.AutomationId="EditPaymentMethod"/></WrapPanel>
                <StackPanel IsVisible="{Binding IsPaymentMethodEditing}" IsEnabled="{Binding CanEditFinance}" Spacing="6"><TextBlock Text="Stabilny kod techniczny"/><TextBox Text="{Binding PaymentMethodEditor.Code}" IsReadOnly="True" AutomationProperties.AutomationId="PaymentMethodCode"/><TextBlock Text="Nazwa sposobu płatności"/><TextBox Text="{Binding PaymentMethodEditor.Name, Mode=TwoWay}" MaxLength="100" AutomationProperties.AutomationId="PaymentMethodName"/><CheckBox Content="Aktywny sposób płatności" IsChecked="{Binding PaymentMethodEditor.IsActive, Mode=TwoWay}" AutomationProperties.AutomationId="PaymentMethodActive"/><WrapPanel><Button Content="Zapisz sposób" Click="SavePaymentMethodClick" IsEnabled="{Binding CanSaveFinance}" AutomationProperties.AutomationId="SavePaymentMethod"/><Button Content="Anuluj szkic sposobu" Click="CancelPaymentMethodClick" AutomationProperties.AutomationId="CancelPaymentMethod"/></WrapPanel></StackPanel>
              </StackPanel>
            </Expander>
            <Border IsVisible="{Binding HasFinanceConflict}" BorderBrush="#B77816" BorderThickness="1" Padding="12"><StackPanel Spacing="8"><TextBlock Text="Konflikt finansów — Twoje pola / wersja serwera" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding FinanceLocalSummary}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding FinanceServerSummary}" TextWrapping="Wrap"/></Grid><WrapPanel><Button Content="Wczytaj wersję serwera" Click="ReloadFinanceConflictClick" AutomationProperties.AutomationId="ReloadFinanceConflict"/><Button Content="Zachowaj moje pola" Click="KeepFinanceConflictClick" AutomationProperties.AutomationId="KeepFinanceConflict"/></WrapPanel></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" IsVisible="{Binding IsVerificationsTab}" ColumnDefinitions="340,*" ColumnSpacing="16">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8"><Button Content="Pobierz dane z DataPort" Click="DataPortClick" IsEnabled="{Binding CanVerify}" AutomationProperties.AutomationId="VerifyDataPort"/><TextBlock Text="DataPort (dane GUS) — rzeczywista usługa pośrednika, możliwy cache. Wymaga klucza w ustawieniach firmy. Nie jest bezpośrednią odpowiedzią GUS." TextWrapping="Wrap"/><TextBlock Text="Historia weryfikacji" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="TEST/MOCK nie potwierdzają rzeczywistej rejestracji. Historia jest niezmienna; kolejne ręczne sprawdzenie dodaje nowe zdarzenie." TextWrapping="Wrap"/><Button Content="Odśwież historię" Click="VerificationsClick" IsEnabled="{Binding HasSavedContractor}" AutomationProperties.AutomationId="RefreshVerifications"/>
            <ListBox ItemsSource="{Binding VerificationRows}" SelectedItem="{Binding SelectedVerification, Mode=TwoWay}" Height="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="VerificationRows"><ListBox.ItemTemplate><DataTemplate x:DataType="contracts:VerificationResponse"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
            <WrapPanel><Button Content="Poprzednie" Click="PreviousVerificationsClick" IsEnabled="{Binding HasPreviousVerifications}"/><Button Content="Następne" Click="NextVerificationsClick" IsEnabled="{Binding HasNextVerifications}"/></WrapPanel><TextBlock Text="{Binding VerificationPage}"/>
          </StackPanel>
          </ScrollViewer>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10" Margin="0,0,16,8"><TextBlock Text="{Binding VerificationSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="VerificationSummary"/>
            <StackPanel IsVisible="{Binding CanImportGus}" Spacing="7"><TextBlock Text="Porównaj i wybierz pobrane dane" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding GusComparison}" TextWrapping="Wrap"/>
              <CheckBox Content="Przenieś nazwę do danych głównych" IsChecked="{Binding UseGusName, Mode=TwoWay}" AutomationProperties.AutomationId="UseGusName"/><TextBlock Text="Wybierz pola nowego adresu (wartości ze źródła pokazano wyżej):" TextWrapping="Wrap"/>
              <WrapPanel><CheckBox Content="Ulica" IsChecked="{Binding UseGusStreet, Mode=TwoWay}"/><CheckBox Content="Budynek" IsChecked="{Binding UseGusBuilding, Mode=TwoWay}"/><CheckBox Content="Lokal" IsChecked="{Binding UseGusApartment, Mode=TwoWay}"/><CheckBox Content="Kod pocztowy" IsChecked="{Binding UseGusPostalCode, Mode=TwoWay}"/><CheckBox Content="Miejscowość" IsChecked="{Binding UseGusCity, Mode=TwoWay}"/><CheckBox Content="Kraj" IsChecked="{Binding UseGusCountry, Mode=TwoWay}"/></WrapPanel>
              <Button Content="Przenieś wybrane wartości do szkicu" Click="ApplyGusClick" AutomationProperties.AutomationId="ApplyGus"/><TextBlock Text="To nie zapisuje danych. Następnie sprawdź formularz i zapisz zwykłym API." TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel></ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
          <Border IsVisible="{Binding HasIdentifierWarning}" BorderBrush="#B77816" BorderThickness="1" Padding="10"><StackPanel Spacing="6"><ScrollViewer MaxHeight="100"><TextBlock Text="{Binding IdentifierSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="IdentifierSummary"/></ScrollViewer><Button Content="Zapisz mimo ostrzeżenia identyfikatorów" Click="AcceptIdentifiersClick" IsEnabled="{Binding CanAcceptWarnings}" AutomationProperties.AutomationId="AcceptIdentifierWarning"/></StackPanel></Border>
          <Border IsVisible="{Binding HasConflict}" BorderBrush="#B77816" BorderThickness="1" Padding="10">
            <StackPanel Spacing="6"><TextBlock Text="Konflikt danych głównych — porównaj przed zapisem" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding LocalVersionSummary}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding ServerVersionSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConflictCurrent"/></Grid><WrapPanel><Button Content="Wczytaj wersję z serwera" Click="ReloadConflictClick" AutomationProperties.AutomationId="ReloadConflict"/><Button Content="Zachowaj moje pola" Click="KeepConflictClick" AutomationProperties.AutomationId="KeepConflict"/></WrapPanel></StackPanel>
          </Border>
          <Border IsVisible="{Binding HasDetailConflict}" BorderBrush="#B77816" BorderThickness="1" Padding="10"><StackPanel Spacing="6"><TextBlock Text="Konflikt pozycji — porównaj wersje" FontWeight="SemiBold"/><ScrollViewer MaxHeight="180"><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding DetailLocalSummary}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding DetailServerSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="DetailConflictCurrent"/></Grid></ScrollViewer><WrapPanel><Button Content="Wczytaj wersję serwera" Click="ReloadDetailConflictClick" AutomationProperties.AutomationId="ReloadDetailConflict"/><Button Content="Zachowaj moje pola" Click="KeepDetailConflictClick" AutomationProperties.AutomationId="KeepDetailConflict"/></WrapPanel></StackPanel></Border>
          <Border IsVisible="{Binding HasBankWarning}" BorderBrush="#B77816" BorderThickness="1" Padding="10"><StackPanel Spacing="6"><TextBlock Text="{Binding BankWarning}" TextWrapping="Wrap"/><WrapPanel><Button Content="Świadomie zapisz pomimo ostrzeżenia" Click="AcceptBankWarningClick" IsEnabled="{Binding CanAcceptWarnings}" AutomationProperties.AutomationId="AcceptBankWarning"/><Button Content="Wróć do formularza" Click="CancelBankWarningClick" AutomationProperties.AutomationId="CancelBankWarning"/></WrapPanel><TextBlock IsVisible="{Binding !CanAcceptWarnings}" Text="Brak uprawnienia akceptowania ostrzeżeń."/></StackPanel></Border>
          <WrapPanel>
            <Button Content="Zapisz dane główne (Ctrl+S)" Click="SaveContractorClick" IsVisible="{Binding IsMainTab}" IsEnabled="{Binding CanSaveContractor}" AutomationProperties.AutomationId="SaveContractor"/>
            <Button Content="Zapisz pozycję (Ctrl+S)" Click="SaveDetailClick" IsVisible="{Binding IsDetailEditing}" IsEnabled="{Binding CanSaveDetail}" AutomationProperties.AutomationId="SaveDetail"/>
            <Button Content="Anuluj pozycję (Esc)" Click="CancelDetailClick" IsVisible="{Binding IsDetailEditing}" AutomationProperties.AutomationId="CancelDetail"/>
            <Button Content="Zamknij kartotekę (Esc)" Click="CancelContractorClick" AutomationProperties.AutomationId="CancelContractor"/>
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8">
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="4" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 AutomationProperties.AutomationId="StatusMessage" />
    </StackPanel>
    <TextBlock Grid.Row="3" Text="Kartoteka kontrahentów · brak funkcji księgowych" FontSize="12" Opacity="0.65" />
    <Border Grid.RowSpan="4" IsVisible="{Binding DiscardPrompt}" Background="#EEFFFFFF" BorderBrush="#B77816" BorderThickness="2" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
      <StackPanel Spacing="16"><TextBlock Text="Porzucić niezapisane zmiany?" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Zmiany w formularzu zostaną utracone. Zapisane wcześniej pozycje pozostaną w bazie." TextWrapping="Wrap"/><WrapPanel><Button Content="Wróć do edycji" Click="KeepEditingClick" AutomationProperties.AutomationId="KeepEditing"/><Button Content="Porzuć niezapisane zmiany" Click="DiscardClick" AutomationProperties.AutomationId="DiscardChanges"/></WrapPanel></StackPanel>
    </Border>  </Grid>
</Window>
